D AS" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1308" y="585" width="80" height="25" as="geometry"/></mxCell><mxCell id="n17" value="(0,N)" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="803" y="445" width="69" height="27" as="geometry"/></mxCell><mxCell id="n18" value="(1,1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="803" y="690" width="69" height="27" as="geometry"/></mxCell><mxCell id="n19" value="IS NEAR (M:N)" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="598" y="566" width="138" height="25" as="geometry"/></mxCell><mxCell id="n21" value="(0,N)" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="390" y="790" width="69" height="27" as="geometry"/></mxCell><mxCell id="n22" value="(1,1)" style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="473" y="840" width="69" height="27" as="geometry"/></mxCell><mxCell id="n23" value="IS NEAR" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="393" y="872" width="80" height="25" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;town&lt;/b&gt;&lt;hr&gt;PK town_name" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="340" height="135" as="geometry"/></mxCell><mxCell id="n25" value='&lt;b&gt;hdb_building&lt;/b&gt;&lt;hr&gt;PK building_id&lt;br&gt;FK town_name -&amp;gt; town&lt;br&gt;block&lt;br&gt;street_name&lt;br&gt;latitude ?&lt;br&gt;longitude ?&lt;br&gt;&lt;br&gt;&lt;font color="#53677f"&gt;UQ (block, street_name)&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="500" height="310" as="geometry"/></mxCell><mxCell id="n26" value='&lt;b&gt;hdb_flat (observed profile)&lt;/b&gt;&lt;hr&gt;PK flat_id&lt;br&gt;FK building_id -&amp;gt; hdb_building&lt;br&gt;flat_type&lt;br&gt;storey_lower, storey_upper&lt;br&gt;floor_area_sqm&lt;br&gt;flat_model&lt;br&gt;lease_commence_year&lt;br&gt;&lt;br&gt;&lt;font color="#53677f"&gt;UQ (building_id, flat_type, storey_lower,&lt;br&gt;storey_upper, floor_area_sqm,&lt;br&gt;flat_model, lease_commence_year)&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1180" y="120" width="480" height="400" as="geometry"/></mxCell><mxCell id="n27" value='&lt;b&gt;resale_transaction&lt;/b&gt;&lt;hr&gt;PK transaction_id&lt;br&gt;FK flat_id -&amp;gt; hdb_flat&lt;br&gt;sale_month&lt;br&gt;resale_price&lt;br&gt;remaining_lease_months ?&lt;br&gt;lease_basis&lt;br&gt;source_dataset, source_row&lt;br&gt;&lt;br&gt;&lt;font color="#53677f"&gt;UQ (source_dataset, source_row)&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1180" y="680" width="480" height="345" as="geometry"/></mxCell><mxCell id="n28" value='&lt;b&gt;hawker_centre&lt;/b&gt;&lt;hr&gt;PK hawker_id&lt;br&gt;centre_name&lt;br&gt;address&lt;br&gt;market_produce_stalls&lt;br&gt;latitude ?&lt;br&gt;longitude ?&lt;br&gt;&lt;br&gt;&lt;font color="#53677f"&gt;UQ (centre_name, address)&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="680" width="340" height="330" as="geometry"/></mxCell><mxCell id="n29" value='&lt;b&gt;building_hawker (IS NEAR)&lt;/b&gt;&lt;hr&gt;PK/FK building_id -&amp;gt; hdb_building&lt;br&gt;PK/FK hawker_id -&amp;gt; hawker_centre&lt;br&gt;distance_m&lt;br&gt;~ proximity_class (view, not stored)&lt;br&gt;&lt;br&gt;&lt;font color="#53677f"&gt;Composite PK (building_id, hawker_id)&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;fillColor=#ffffff;strokeColor=#8fa2ba;fontSize=17;" vertex="1" parent="1"><mxGeometry x="540" y="730" width="500" height="235" as="geometry"/></mxCell><mxCell id="n30" value="(1,1) = each row has one NOT NULL FK; (0,N) = a referenced row may have any number. ? = nullable; never (0,0)." style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#1b2d45;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="38" y="1049" width="1332" height="28" as="geometry"/></mxCell><mxCell id="n31" value="proximity_class() and views building_hawker_proximity / nearest_hawker / nearest_market_hawker are derived, not stored." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="38" y="1084" width="1233" height="27" as="geometry"/></mxCell><mxCell id="n32" value="The M:N relationship IS NEAR becomes the associative table building_hawker; each 1:N becomes a NOT NULL FK." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="38" y="1117" width="1110" height="27" as="geometry"/></mxCell><mxCell id="n33" value="PK = primary key; FK = foreign key; UQ = alternate key. Precise types and CHECK constraints are in db/schema/001_schema.sql." style="text;html=1;align=left;verticalAlign=middle;fontSize=19;fontColor=#1b2d45;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="38" y="1150" width="1284" height="27" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
