/************************/

ANALYZE
/******** QUERY *********/
ANALYZE housing.building_hawker;
/************************/

ANALYZE
/******** QUERY *********/
SELECT 'town' AS table_name, count(*) AS rows FROM housing.town
UNION ALL
SELECT 'hdb_building' AS table_name, count(*) AS rows FROM housing.hdb_building
UNION ALL
SELECT 'hdb_flat' AS table_name, count(*) AS rows FROM housing.hdb_flat
UNION ALL
SELECT 'resale_transaction' AS table_name, count(*) AS rows FROM housing.resale_transaction
UNION ALL
SELECT 'hawker_centre' AS table_name, count(*) AS rows FROM housing.hawker_centre
UNION ALL
SELECT 'building_hawker' AS table_name, count(*) AS rows FROM housing.building_hawker;
/************************/

